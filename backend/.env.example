# Safe local defaults. Cloud IAM configuration is supplied by Terraform.
APP_ENV=local
DB_MODE=disabled
MAX_BODY_BYTES=16384
# Local integration/migrations only, never use this mode in staging/production:
# DB_MODE=local
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=noryva_test
# DB_USER=noryva_test
# DB_PASSWORD=<local-only-password>
